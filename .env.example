# Carto basemaps API key — required to remove watermarks
# Get a free key at https://carto.com/basemaps/apikey/
# Restrict it to your domain in the Carto dashboard.
#
# Setup:
#   1. Copy this file to .env.local:  cp .env.example .env.local
#   2. Paste your key below and restart `pnpm dev`
#   3. On Vercel/host, add the same var in dashboard env settings
#
# The NEXT_PUBLIC_ prefix is required because tile URLs are fetched
# client-side (visible in network requests). Domain restriction on the
# key is your abuse protection — the key is not a secret.
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
